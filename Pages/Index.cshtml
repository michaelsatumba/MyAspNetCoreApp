@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}



@* Div 1 *@
@* Title / Logo *@
@* Phone *@
@* Search *@
<div class="container">
    <div class="d-flex justify-content-between bg-gray">
        <div>
            <img src="images/logo.png" alt="Logo" class="img-fluid w-75">
        </div>
                <!-- Dropdown 1: Brakes Kits -->
        <div class="dropdown">
            <button class="btn dropdown-toggle" type="button" id="dropdownMenu1" data-bs-toggle="dropdown" aria-expanded="false">
                Brakes Kits
            </button>
            <ul class="dropdown-menu" aria-labelledby="dropdownMenu1">
                <li><a class="dropdown-item" href="#">Disc Brakes</a></li>
                <li><a class="dropdown-item" href="#">Drum Brakes</a></li>
                <li><a class="dropdown-item" href="#">Conversion Kits</a></li>
            </ul>
        </div>

        <!-- Dropdown 2: Products -->
        <div class="dropdown">
            <button class="btn dropdown-toggle" type="button" id="dropdownMenu2" data-bs-toggle="dropdown" aria-expanded="false">
                Products
            </button>
            <ul class="dropdown-menu" aria-labelledby="dropdownMenu2">
                <li><a class="dropdown-item" href="#">Brake Pads</a></li>
                <li><a class="dropdown-item" href="#">Rotors</a></li>
                <li><a class="dropdown-item" href="#">Calipers</a></li>
            </ul>
        </div>

        <!-- Dropdown 3: Applications -->
        <div class="dropdown">
            <button class="btn dropdown-toggle" type="button" id="dropdownMenu3" data-bs-toggle="dropdown" aria-expanded="false">
                Applications
            </button>
            <ul class="dropdown-menu" aria-labelledby="dropdownMenu3">
                <li><a class="dropdown-item" href="#">Automotive</a></li>
                <li><a class="dropdown-item" href="#">Industrial</a></li>
                <li><a class="dropdown-item" href="#">Racing</a></li>
            </ul>
        </div>

        <!-- Dropdown 4: About -->
        <div class="dropdown">
            <button class="btn dropdown-toggle" type="button" id="dropdownMenu4" data-bs-toggle="dropdown" aria-expanded="false">
                About
            </button>
            <ul class="dropdown-menu" aria-labelledby="dropdownMenu4">
                <li><a class="dropdown-item" href="#">Company History</a></li>
                <li><a class="dropdown-item" href="#">Our Team</a></li>
                <li><a class="dropdown-item" href="#">Careers</a></li>
            </ul>
        </div>
        <form class="d-flex" role="search">
            <input class="form-control me-2" type="search" placeholder="Search" aria-label="Search">
            <button class="btn btn-outline-success" type="submit"><i class="fas fa-search"></i></button>
        </form>
    </div>
</div>

@* Div 2 *@
@* Search *@
<div class="container mt-4">
    <h2>Search Bolt-On & Conversion Brakes Kits by Vehicle</h2>
    <div class="row">
        <div class="col">
            <label for="year" class="form-label">Year</label>
            <select id="year" class="form-select">
                <option value="2025">2025</option>
            </select>
        </div>
        <div class="col">
            <label for="make" class="form-label">Make</label>
            <select id="make" class="form-select">
                <option value="Honda">Honda</option>
            </select>
        </div>
        <div class="col">
            <label for="model" class="form-label">Model</label>
            <select id="model" class="form-select">
                <option value="Civic">Civic</option>
            </select>
        </div>
        <div class="col">
            <label for="model" class="form-label">Option</label>
            <select id="model" class="form-select">
                <option value="Civic">Hybrid</option>
            </select>
        </div>
         <div class="col d-flex align-items-center">
            <button class="btn btn-primary">Search</button>
        </div>
    </div>
</div>


@* Div 3 *@
@* Pictures *@
<div id="carouselExample" class="carousel slide mt-4" data-bs-ride="carousel">
    <div class="carousel-inner">
        <div class="carousel-item active">
            <img src="https://picsum.photos/id/183/932/328" class="d-block w-75 mx-auto" alt="Image 1">
        </div>
        <div class="carousel-item">
            <img src="https://picsum.photos/id/133/932/328" class="d-block w-75 mx-auto" alt="Image 2">
        </div>
        <div class="carousel-item">
            <img src="https://picsum.photos/id/111/932/328" class="d-block w-75 mx-auto" alt="Image 3">
        </div>
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#carouselExample" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#carouselExample" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
    </button>
</div>


@* Div 4 *@
@* Pictures *@
<div class="text-center px-5 mt-4">
    <img src="images/cars.png" alt="My Image" class="img-fluid w-75">
</div>

@* Div 5 *@
@* Title  *@
@* Pictures *@
<div class="text-center mt-4">
    <div>
        <h2>Willwood Products Catalog</h2>
        <p class="text-blue">Designed • Tested • Manufactured in U.S.A.</p>
        <p>ESTABLISHED 1977</p>
    </div>
    <div>
        <div class="text-center px-5">
            <img src="images/parts.png" alt="My Image" class="img-fluid w-75">
        </div>
    </div>
</div>

