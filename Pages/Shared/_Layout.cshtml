    </li>
    <li class="nav-item">
        <a class="nav-link" asp-area="" asp-page="/Privacy">INDUSTRIAL/OEM</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" asp-area="" asp-page="/Privacy">NEWS/MEDIA</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" asp-area="" asp-page="/Privacy">TECH SUPPORT</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" asp-area="" asp-page="/Privacy">WILLWOOD STORE</a>
    </li>
</ul>
                <div class="d-flex align-items-center">
                <a href="https://facebook.com" target="_blank" class="text-decoration-none me-3">
                    <i class="fab fa-facebook fa-lg"></i>
                </a>
                <a href="https://twitter.com" target="_blank" class="text-decoration-none me-3">
                    <i class="fab fa-twitter fa-lg"></i>
                </a>
                <a href="https://youtube.com" target="_blank" class="text-decoration-none me-3">
                    <i class="fab fa-youtube fa-lg"></i>
                </a>
                <a href="https://instagram.com" target="_blank" class="text-decoration-none">
                    <i class="fab fa-instagram fa-lg"></i>
                </a>
            </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
